# Copy to .env, or run `make env`, which does it for you with a fresh random password.
# Every value below is a placeholder. None of them is, or ever was, a real credential.

# The demo database. `make env` writes a random one; if you change it later, run `make reset` (the volume still holds the old one).
POSTGRES_PASSWORD=replace-with-a-long-random-value

# Optional: the port the site is published on (always on 127.0.0.1 only).
# GW_PORT=8100
